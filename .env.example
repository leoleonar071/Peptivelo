NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chosen brand; confirm domain registration and name clearance before launch.
NEXT_PUBLIC_SITE_NAME=Peptivelo
# Set true only after configuring the production domain and reviewing content/policies.
SITE_INDEXABLE=false
# Optional future PostgreSQL adapter; the MVP reads validated versioned JSON.
DATABASE_URL=postgresql://user:password@localhost:5432/peptide_atlas
# Published at the owner's request. Mail delivery will be configured separately.
CONTACT_EMAIL=suppor@peptivelo.com
# Real individual or entity operating the site; never invent these values.
SITE_OPERATOR_NAME=
# Current public deployment; update if the hosting platform changes.
HOSTING_PROVIDER=Cloudflare Workers
# Actual operating jurisdiction, supplied by the owner (not the audience market).
SITE_OPERATING_JURISDICTION=
# Owner-verified description of technical log retention; do not guess a duration.
HOSTING_LOG_RETENTION=
