{
  "name": "peptide-atlas",
  "version": "1.0.0",
  "description": "Source-traceable peptide skincare comparison MVP",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate",
    "format": "prettier --write src tests e2e docs README.md",
    "dev:vinext": "vite dev --host 127.0.0.1 --port 3101 --strictPort",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "check:vinext": "vinext check",
    "test:e2e:vinext": "playwright test --config playwright.vinext.config.ts",
    "types:workers": "cf workers types",
    "audit:launch": "node --env-file-if-exists=.env.local scripts/audit-launch.mjs",
    "audit:content": "node scripts/audit-content.mjs"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vinext/cloudflare": "^1.1.1",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.2.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.2",
    "@playwright/test": "^1.64.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
